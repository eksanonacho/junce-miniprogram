// Prisma Schema — 君册财税小程序
// 第一期核心表：users / roles / customers

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// Enums
// ============================================================

// 角色编码（六种角色）
enum RoleCode {
  商务     // 客户主理人/商务岗：谈成交、首次填单提单
  业务     // 业务岗：办理具体业务、办结打卡
  会计     // 会计岗：代理户日常维护、完成任务确认
  主管     // 会计主管/部门主管：发布任务、设时效、评分
  总务     // 总务岗：资金/合同/发票归属、收费管控
  管理员   // 管理员/老板：全局查看、审批
}

// 公司类型
enum CompanyType {
  一人公司
  多股东
  个体户
}

// 客户类别
enum CustomerCategory {
  新用户
  代理户
}

// 客户分层
enum CustomerTier {
  VIP
  优质
  中低
  零申报    // 数据库不支持字段名以数字开头，用中文"零"代替"0"
}

// 客户生命周期阶段
enum LifecycleStage {
  填单      // 主理人刚提交
  办件中    // 对接人正在办理
  办结      // 办结打卡完成
  维护中    // 代理户日常维护
  出库      // 不再服务
}

// 服务项状态
enum ItemStatus {
  待办
  办件中
  办结
}

// 办件状态
enum WorkOrderStatus {
  待办     // 刚创建，等对接人开始
  办件中   // 对接人正在办理
  办结     // 业务办理完成，但尚未完成系统打卡/归档
  已打卡   // 已完成系统打卡，且 archiveFiles 已记录
}

// 收费方式
enum ChargeMode {
  一次性
  定金加尾款
}

// 收费状态
enum ChargeStatus {
  已收
  未收
}

// 任务状态
enum TaskStatus {
  待确认   // 主管刚发布
  进行中   // 员工已确认
  已完成   // 员工已完成
}

// 裂变线索状态
enum FissionStatus {
  待确认   // 刚填单
  已确认   // 相关人员确认
  已归档   // 上传凭证归档
  无效     // 标记无效
}

// ---- 角色表 ----
model Role {
  id        Int       @id @default(autoincrement())
  code      RoleCode  @unique      // 角色编码（枚举值）
  name      String                  // 显示名称，如 "客户主理人"
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt    @map("updated_at")

  users     User[]

  @@map("roles")
}

// ---- 用户表 ----
model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique         // 登录用户名
  passwordHash String    @map("password_hash")  // bcrypt 哈希
  realName      String    @map("real_name")      // 真实姓名
  phone        String?                     // 手机号（可选）
  roleId       Int       @map("role_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt    @map("updated_at")

  // 关联
  role         Role      @relation(fields: [roleId], references: [id])

  // 该用户作为主理人的客户列表
  ownedCustomers Customer[] @relation("Owner")

  // 该用户的已读确认记录
  templateConfirmations ServiceReadConfirmation[]

  // 该用户被指派的人员配置（四个岗位的反向关系）
  businessAssignments  StaffAssignment[] @relation("BusinessStaff")
  accountantAssignments StaffAssignment[] @relation("Accountant")
  consultantAssignments StaffAssignment[] @relation("Consultant")
  generalAffairsAssignments StaffAssignment[] @relation("GeneralAffairs")

  // 该用户作为对接人的办件
  handledWorkOrders    WorkOrder[] @relation("WorkOrderHandler")
  // 该用户作为回执接收人的办件
  receiptWorkOrders    WorkOrder[] @relation("WorkOrderReceiptReceiver")

  // 收费确认/催收
  chargeConfirmations  Charge[] @relation("ChargeConfirmer")
  sentReminders        CollectionReminder[] @relation("ReminderFrom")
  receivedReminders    CollectionReminder[] @relation("ReminderTo")

  // 被分派的托管入档
  tenantAssignments    TenantRegister[] @relation("TenantAccountant")

  // 任务相关
  assignedTasks        Task[] @relation("TaskFrom")
  receivedTasks        Task[] @relation("TaskTo")
  taskConfirmations    Task[] @relation("TaskConfirmer")
  taskCompletions      Task[] @relation("TaskCompleter")

  // 裂变相关
  initiatedLeads       FissionLead[] @relation("FissionInitiator")
  assignedLeads        FissionLead[] @relation("FissionAssignee")
  confirmedLeads       FissionLead[] @relation("FissionConfirmer")
  archivedLeads        FissionLead[] @relation("FissionArchiver")

  // 手动看板
  businessReports      ManualBusinessReport[]
  createdSalaryReports ManualSalaryReport[] @relation("SalaryCreator")
  salaryReports        ManualSalaryReport[] @relation("SalaryUser")

  @@map("users")
}

// ---- 客户表（企业画像） ----
model Customer {
  id               Int              @id @default(autoincrement())
  companyName      String           @map("company_name")      // 企业名称
  industry         String?                                    // 行业
  registerDate     DateTime?        @map("register_date")     // 注册时间
  taxType          String?          @map("tax_type")          // 税务类型
  region           String?                                    // 区域
  annualRevenue    Decimal?         @db.Decimal(12, 2) @map("annual_revenue") // 年流水（金额→Decimal(12,2)，精确到分）
  staffCount       Int?             @map("staff_count")       // 人员数
  companyType      CompanyType?     @map("company_type")      // 一人公司/多股东/个体户
  customerCategory CustomerCategory @map("customer_category") // 新用户/代理户
  tier             CustomerTier?                              // VIP/优质/中低/零申报
  lifecycleStage   LifecycleStage   @default(填单) @map("lifecycle_stage") // 生命周期

  // 主理人（商务岗）
  ownerId          Int              @map("owner_id")
  owner            User             @relation("Owner", fields: [ownerId], references: [id])

  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt      @map("updated_at")

  // 该客户的已读确认记录
  readConfirmations ServiceReadConfirmation[]

  // 该客户的服务项
  serviceItems     ServiceItem[]

  // 该客户的人员配置
  staffAssignment  StaffAssignment?

  // 该客户的办件
  workOrders       WorkOrder[]

  // 该客户的收费
  charge           Charge?

  // 该客户的托管入档
  tenantRegister   TenantRegister?

  // 关联该客户的任务
  tasks            Task[]

  // 该客户作为来源的裂变线索
  fissionLeads      FissionLead[]

  @@map("customers")
}

// ---- 服务模板表 ----
model ServiceTemplate {
  id                Int       @id @default(autoincrement())
  serviceType       String    @map("service_type")    // 服务类型名称，如 "注册"、"食品证"、"代理记账"
  requiredMaterials Json?     @map("required_materials") // JSON数组：["营业执照", "法人身份证", ...]
  processSteps      Json?     @map("process_steps")      // JSON数组：["收集资料", "提交申请", ...]
  estimatedDuration String?   @map("estimated_duration") // "3-5个工作日"、"视材料齐全情况"
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt      @map("updated_at")

  confirmations     ServiceReadConfirmation[]
  serviceItems      ServiceItem[]

  @@map("service_templates")
}

// ---- 已读确认表 ----
model ServiceReadConfirmation {
  id              Int       @id @default(autoincrement())
  customerId      Int       @map("customer_id")
  serviceItemId   Int?      @map("service_item_id")   // 二期关联具体服务项，一期可空
  templateId      Int       @map("template_id")
  userId          Int       @map("user_id")
  confirmedAt     DateTime  @default(now()) @map("confirmed_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  // 关联
  customer        Customer  @relation(fields: [customerId], references: [id])
  template        ServiceTemplate @relation(fields: [templateId], references: [id])
  user            User      @relation(fields: [userId], references: [id])

  // 同一个客户 + 同一个模板 + 同一个人，只记录一次已读确认
  @@unique([customerId, templateId, userId], name: "unique_read_confirmation")
  @@map("service_read_confirmations")
}

// ---- 客户服务项表 ----
model ServiceItem {
  id                Int              @id @default(autoincrement())
  customerId        Int              @map("customer_id")
  serviceTemplateId Int              @map("service_template_id")
  status            ItemStatus       @default(待办)
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt      @map("updated_at")

  // 关联
  customer          Customer         @relation(fields: [customerId], references: [id])
  serviceTemplate   ServiceTemplate  @relation(fields: [serviceTemplateId], references: [id])

  // 办件工单
  workOrder         WorkOrder?

  // 同一客户 + 同一模板唯一，防止重复添加
  @@unique([customerId, serviceTemplateId], name: "unique_customer_service_template")
  @@map("service_items")
}

// ---- 人员配置表 ----
model StaffAssignment {
  id                Int       @id @default(autoincrement())
  customerId        Int       @unique @map("customer_id") // 一个客户只有一份
  businessStaffId   Int?      @map("business_staff_id")
  accountantId      Int?      @map("accountant_id")
  consultantId      Int?      @map("consultant_id")       // TODO: 客户确认顾问岗是否需要独立账号角色后再补
  generalAffairsId  Int?      @map("general_affairs_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt      @map("updated_at")

  // 关联
  customer          Customer  @relation(fields: [customerId], references: [id])
  businessStaff     User?     @relation("BusinessStaff", fields: [businessStaffId], references: [id])
  accountant        User?     @relation("Accountant", fields: [accountantId], references: [id])
  consultant        User?     @relation("Consultant", fields: [consultantId], references: [id])
  generalAffairs    User?     @relation("GeneralAffairs", fields: [generalAffairsId], references: [id])

  @@map("staff_assignments")
}

// ---- 办件工单表 ----
model WorkOrder {
  id                Int              @id @default(autoincrement())
  customerId        Int              @map("customer_id")
  serviceItemId     Int              @unique @map("service_item_id") // MVP: 一个服务项一个办件
  handlerId         Int?             @map("handler_id")             // 对接人
  status            WorkOrderStatus  @default(待办)
  receiptReceiverId Int?             @map("receipt_receiver_id")    // 回执接收人
  archiveFiles      Json?            @map("archive_files")          // 归档材料：[{name,url,size,uploadedAt}]
  completedAt       DateTime?        @map("completed_at")           // 办结时间
  checkedInAt       DateTime?        @map("checked_in_at")          // 打卡时间
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt      @map("updated_at")

  // 关联
  customer          Customer         @relation(fields: [customerId], references: [id])
  serviceItem       ServiceItem      @relation(fields: [serviceItemId], references: [id])
  handler           User?            @relation("WorkOrderHandler", fields: [handlerId], references: [id])
  receiptReceiver   User?            @relation("WorkOrderReceiptReceiver", fields: [receiptReceiverId], references: [id])

  @@map("work_orders")
}

// ---- 收费记录表 ----
model Charge {
  id            Int           @id @default(autoincrement())
  customerId    Int           @unique @map("customer_id") // MVP: 一个客户一条收费记录
  chargeMode    ChargeMode    @map("charge_mode")
  amount        Decimal       @db.Decimal(12, 2)
  chargeStatus  ChargeStatus  @default(未收) @map("charge_status")
  contractNo    String?       @map("contract_no")
  invoiceNo     String?       @map("invoice_no")
  confirmedBy   Int?          @map("confirmed_by")
  confirmedAt   DateTime?     @map("confirmed_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt      @map("updated_at")

  customer      Customer      @relation(fields: [customerId], references: [id])
  confirmer     User?         @relation("ChargeConfirmer", fields: [confirmedBy], references: [id])
  reminders     CollectionReminder[]

  @@map("charges")
}

// ---- 催收记录表 ----
model CollectionReminder {
  id          Int       @id @default(autoincrement())
  chargeId    Int       @map("charge_id")
  fromUserId  Int       @map("from_user_id")
  toUserId    Int       @map("to_user_id")
  message     String?
  createdAt   DateTime  @default(now()) @map("created_at")

  charge      Charge    @relation(fields: [chargeId], references: [id])
  fromUser    User      @relation("ReminderFrom", fields: [fromUserId], references: [id])
  toUser      User      @relation("ReminderTo", fields: [toUserId], references: [id])

  @@map("collection_reminders")
}

// ---- 业务裂变线索表 ----
model FissionLead {
  id                Int            @id @default(autoincrement())
  sourceCustomerId  Int?           @map("source_customer_id")  // 来源客户，可空
  initiatedById     Int            @map("initiated_by_id")     // 发起人，JWT 自动取
  price             Decimal?       @db.Decimal(12, 2)         // 仅记录报价，不参与佣金/奖励/收费
  leadName          String?        @map("lead_name")
  contactName       String?        @map("contact_name")
  phone             String?
  description       String?
  assigneeId        Int?           @map("assignee_id")
  status            FissionStatus  @default(待确认)
  confirmedById     Int?           @map("confirmed_by_id")
  confirmedAt       DateTime?      @map("confirmed_at")
  archivedById      Int?           @map("archived_by_id")
  archivedAt        DateTime?      @map("archived_at")
  archiveFiles      Json?          @map("archive_files")       // [{name,url,size,mimeType,uploadedAt}]
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt      @map("updated_at")

  sourceCustomer    Customer?      @relation(fields: [sourceCustomerId], references: [id])
  initiatedBy       User           @relation("FissionInitiator", fields: [initiatedById], references: [id])
  assignee          User?          @relation("FissionAssignee", fields: [assigneeId], references: [id])
  confirmer         User?          @relation("FissionConfirmer", fields: [confirmedById], references: [id])
  archiver          User?          @relation("FissionArchiver", fields: [archivedById], references: [id])

  @@map("fission_leads")
}

// ---- 托管入档表（仅代理户） ----
model TenantRegister {
  id                    Int       @id @default(autoincrement())
  customerId            Int       @unique @map("customer_id") // 一个客户一条
  enterpriseDetail      Json?     @map("enterprise_detail")   // TODO: 字段等客户给
  servicePlan           Json?     @map("service_plan")        // TODO: 内容等客户给
  planConfirmedByOwner  Boolean   @default(false) @map("plan_confirmed_by_owner")
  planConfirmedAt       DateTime? @map("plan_confirmed_at")
  assignedAccountantId  Int?      @map("assigned_accountant_id")
  assignConfirmed       Boolean   @default(false) @map("assign_confirmed")
  assignConfirmedAt     DateTime? @map("assign_confirmed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt      @map("updated_at")

  customer              Customer  @relation(fields: [customerId], references: [id])
  assignedAccountant    User?     @relation("TenantAccountant", fields: [assignedAccountantId], references: [id])

  @@map("tenant_registers")
}

// ---- 任务表（主管→员工） ----
model Task {
  id            Int        @id @default(autoincrement())
  title         String
  content       String?                                    // TODO: 任务1/2/3具体内容等客户给
  fromUserId    Int        @map("from_user_id")            // 发布人（主管）
  toUserId      Int        @map("to_user_id")              // 执行人
  customerId    Int?       @map("customer_id")             // 可选关联客户
  deadline      DateTime
  status        TaskStatus @default(待确认)
  confirmedAt   DateTime?  @map("confirmed_at")
  confirmedById Int?       @map("confirmed_by_id")         // 确认操作人
  completedAt   DateTime?  @map("completed_at")
  completedById Int?       @map("completed_by_id")         // 完成操作人
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt      @map("updated_at")

  fromUser      User       @relation("TaskFrom", fields: [fromUserId], references: [id])
  toUser        User       @relation("TaskTo", fields: [toUserId], references: [id])
  confirmer     User?      @relation("TaskConfirmer", fields: [confirmedById], references: [id])
  completer     User?      @relation("TaskCompleter", fields: [completedById], references: [id])
  customer      Customer?  @relation(fields: [customerId], references: [id])

  @@map("tasks")
}

// ---- 经营手动录入表 ----
model ManualBusinessReport {
  id            Int       @id @default(autoincrement())
  month         String                              // YYYY-MM
  revenueAmount Decimal   @db.Decimal(12, 2) @map("revenue_amount")
  costAmount    Decimal   @db.Decimal(12, 2) @map("cost_amount")
  profitAmount  Decimal   @db.Decimal(12, 2) @map("profit_amount")  // 后端自动计算，前端不传
  note          String?
  createdById   Int       @map("created_by_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt      @map("updated_at")

  createdBy     User      @relation(fields: [createdById], references: [id])

  @@map("manual_business_reports")
}

// ---- 工资手动录入表 ----
model ManualSalaryReport {
  id              Int       @id @default(autoincrement())
  month           String                              // YYYY-MM
  userId          Int       @map("user_id")
  baseSalary      Decimal   @default(0) @db.Decimal(12, 2) @map("base_salary")
  commission      Decimal   @default(0) @db.Decimal(12, 2)
  bonus           Decimal   @default(0) @db.Decimal(12, 2)
  deduction       Decimal   @default(0) @db.Decimal(12, 2)
  socialInsurance Decimal   @default(0) @db.Decimal(12, 2) @map("social_insurance")
  totalAmount     Decimal   @db.Decimal(12, 2) @map("total_amount")  // 后端自动计算，前端不传
  note            String?
  createdById     Int       @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt      @map("updated_at")

  createdBy       User      @relation("SalaryCreator", fields: [createdById], references: [id])
  user            User      @relation("SalaryUser", fields: [userId], references: [id])

  @@unique([month, userId], name: "unique_month_user")
  @@map("manual_salary_reports")
}

// ---- 消息通知表 ----
model Notification {
  id          Int       @id @default(autoincrement())
  type        String                        // work_order / task / charge / tenant / fission / system
  title       String
  body        String
  senderId    Int?     @map("sender_id")
  receiverId  Int      @map("receiver_id")
  roleTarget  String?  @map("role_target")
  targetType  String?  @map("target_type")
  targetId    Int?     @map("target_id")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([receiverId, isRead])
  @@index([receiverId, createdAt])
  @@map("notifications")
}
