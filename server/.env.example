# ============================================================
# 君册财税小程序 — 后端环境变量
# ============================================================
# 本文件为示例模板，可安全提交到 git。
# 真实值放在 server/.env（已在 .gitignore 中排除）。
# 生产部署前必须替换所有 <...> 占位符。
# ============================================================

# ---- 数据库 ----
# 开发（本地 PostgreSQL）：
#   DATABASE_URL="postgresql://用户名@localhost:5432/junce_dev?schema=public"
# Docker（容器内）：
#   DATABASE_URL="postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/<POSTGRES_DB>?schema=public"
# ⚠️ 生产必须替换密码
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ---- JWT ----
# ⚠️ 生产必须替换为 openssl rand -hex 64 生成的强随机字符串
JWT_SECRET="<openssl rand -hex 64>"
# ⚠️ 当前未生效：代码中 14 个模块硬编码 expiresIn: '7d'，从未读取此变量。
# 此变量为计划支持但尚未接入的占位，本期不改（回归影响面广）。
JWT_EXPIRES_IN="7d"

# ---- 服务器 ----
PORT=3000

# ---- 环境 ----
# development（开发）= 宽松 CORS + 允许 dev JWT fallback
# production（生产） = 必须设置 CORS_ORIGIN + JWT_SECRET，否则启动失败
NODE_ENV=development

# ---- CORS（生产必填）----
# 生产环境必须显式设置前端来源域名（不是后端 API 域名）。
# 支持逗号分隔的多域名白名单，如：
#   CORS_ORIGIN=https://app.example.com,https://admin.example.com
# ⚠️ 生产必须替换
CORS_ORIGIN=https://app.example.com

# ---- 种子数据 ----
# 设 true 则容器启动时执行 prisma db seed。
# 生产首次部署设 true，后续日常启动设 false 或不设。
RUN_SEED=false
